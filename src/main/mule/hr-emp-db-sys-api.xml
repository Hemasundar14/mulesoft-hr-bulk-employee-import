                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="hr-emp-db-sys-api-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="put:\import-runs\(runId):application\json:hr-emp-db-sys-api-config">
		<db:update doc:name="Update" doc:id="c8a5eea6-f4f5-425e-943f-c151ab9808f6" config-ref="Database_Config">
			<db:sql ><![CDATA[UPDATE employee_import_runs
SET parsed_count = :parsedCount,
    inserted_count = :insertedCount,
    updated_count = :updatedCount,
    rejected_count = :rejectedCount,
    reject_percent = :rejectPercent,
    run_status = :runStatus,
    reject_file_path = :rejectFilePath,
    completed_at = NOW()
WHERE run_id = :runId]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
  parsedCount: payload.parsedCount,
  insertedCount: payload.insertedCount,
  updatedCount: payload.updatedCount,
  rejectedCount: payload.rejectedCount,
  rejectPercent: payload.rejectPercent,
  runStatus: payload.runStatus,
  rejectFilePath: payload.rejectFilePath,
  runId: attributes.uriParams.runId
}]]]></db:input-parameters>
		</db:update>
		<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Run updated",
  affectedRows: payload.affectedRows
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
