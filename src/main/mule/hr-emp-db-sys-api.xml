    <flow name="post:\employees\batch:application\json:hr-emp-db-sys-api-config">
		<set-variable value="#[payload]" doc:name="Set Variable" doc:id="6abafa6a-1d79-4868-9bcd-d6d11364243d" variableName="rows"/>
		<db:bulk-insert doc:name="Bulk insert" doc:id="8378c8c5-c5bc-400d-aa36-2c58a8bc8d4a" config-ref="Database_Config">
			<db:bulk-input-parameters ><![CDATA[#[payload map ($ ++ { source_run_id: $.source_run_id default "run-001" })]]]></db:bulk-input-parameters>
			<db:sql ><![CDATA[INSERT INTO employees (employee_id, first_name, last_name, date_of_birth, date_of_joining, official_email, mobile, department_key, designation, grade, location_key, employment_type, manager_key, employee_status, source_run_id) VALUES (:employee_id, :first_name, :last_name, :date_of_birth, :date_of_joining, :official_email, :mobile, :department_key, :designation, :grade, :location_key, :employment_type, :manager_key, :employee_status, :source_run_id) ON DUPLICATE KEY UPDATE first_name = VALUES(first_name), last_name = VALUES(last_name), date_of_birth = VALUES(date_of_birth), date_of_joining = VALUES(date_of_joining), official_email = VALUES(official_email), mobile = VALUES(mobile), department_key = VALUES(department_key), designation = VALUES(designation), grade = VALUES(grade), location_key = VALUES(location_key), employment_type = VALUES(employment_type), manager_key = VALUES(manager_key), employee_status = VALUES(employee_status), source_run_id = VALUES(source_run_id), updated_at = CURRENT_TIMESTAMP]]></db:sql>
		</db:bulk-insert>
		<ee:transform doc:name="Transform Message" doc:id="d382a372-757e-48a7-984d-bf0733c43105" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  message: "Batch processed",
  received: sizeOf(vars.rows)
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
    </flow>
    <flow name="post:\import-rejects:application\json:hr-emp-db-sys-api-config">
		<choice doc:name="Is Array?">
			<when expression="#[payload is Array]">
				<db:bulk-insert doc:name="Bulk insert rejects" config-ref="Database_Config">
					<db:bulk-input-parameters><![CDATA[#[payload map {
						run_id: $.run_id,
						record_index: $.record_index,
						employee_id: $.employee_id,
						reject_code: $.reject_code,
						reject_reason: $.reject_reason
					}]]]></db:bulk-input-parameters>
					<db:sql><![CDATA[INSERT INTO employee_import_rejects (run_id, record_index, employee_id, reject_code, reject_reason) VALUES (:run_id, :record_index, :employee_id, :reject_code, :reject_reason)]]></db:sql>
				</db:bulk-insert>
			</when>
			<otherwise>
				<db:insert doc:name="Insert single reject" doc:id="5762691d-85c8-466d-9101-4806cedac8ef" config-ref="Database_Config">
					<db:sql><![CDATA[INSERT INTO employee_import_rejects (run_id, record_index, employee_id, reject_code, reject_reason) VALUES (:runId, :recordIndex, :employeeId, :rejectCode, :rejectReason)]]></db:sql>
					<db:input-parameters><![CDATA[#[{ runId: payload.run_id, recordIndex: payload.record_index, employeeId: payload.employee_id, rejectCode: payload.reject_code, rejectReason: payload.reject_reason }]]]></db:input-parameters>
				</db:insert>
			</otherwise>
		</choice>
		<set-variable value="201" doc:name="Set Variable" doc:id="22f410ad-6ec3-4969-9251-de118e2a9239" variableName="httpStatus"/>
		<ee:transform doc:name="Transform Message" doc:id="f546b205-1ee3-4ff4-b5f1-6aad9efc08c1" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{ message: "Reject(s) saved" }]]></ee:set-payload>
			</ee:message>
		</ee:transform>
    </flow>
    <flow name="post:\import-runs:application\json:hr-emp-db-sys-api-config">
		<db:insert doc:name="Insert" doc:id="9eccec5d-3788-4625-be15-7964308e2935" config-ref="Database_Config">
			<db:sql ><![CDATA[INSERT INTO employee_import_runs (run_id, file_name, file_format, file_checksum, declared_count, run_status, started_at, correlation_id) VALUES (:runId, :fileName, :fileFormat, :checksum, :declaredCount, :runStatus, NOW(), :correlationId)]]></db:sql>
			<db:input-parameters ><![CDATA[#[{ runId: payload.runId, fileName: payload.fileName, fileFormat: payload.fileFormat, checksum: payload.fileChecksum, declaredCount: payload.declaredCount, runStatus: payload.runStatus default "STARTED", correlationId: payload.correlationId }]]]></db:input-parameters>
		</db:insert>
		<set-variable value="201" doc:name="Set Variable" doc:id="5ab92217-84a2-4bb6-8015-a4c47d6c5811" variableName="httpStatus"/>
		<ee:transform doc:name="Transform Message" doc:id="1b092726-c243-4145-b37a-35f171ec0cf7" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{ message: "Run created", affectedRows: payload.affectedRows }]]></ee:set-payload>
			</ee:message>
		</ee:transform>
    </flow>
</mule>